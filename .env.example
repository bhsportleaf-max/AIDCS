# Base environment
AIDCS_ENV=development

# ========= Agent overrides (comma-separated sections) =========
# Assistant
AIDCS_AGENT_ASSISTANT_AGENT_SECTIONS=AI-Sect-1-HDR,AI-Sect-2-NAV,AI-Sect-3-CNT,AI-Sect-4-DSP,AI-Sect-5-AIC
AIDCS_AGENT_ASSISTANT_AGENT_PRIORITY=1
AIDCS_AGENT_ASSISTANT_AGENT_MAX_ACTIONS=5
AIDCS_AGENT_ASSISTANT_AGENT_CONFIDENCE=0.9

# Navigation
AIDCS_AGENT_NAVIGATION_AGENT_SECTIONS=AI-Sect-2-NAV
AIDCS_AGENT_NAVIGATION_AGENT_PRIORITY=2
AIDCS_AGENT_NAVIGATION_AGENT_MAX_ACTIONS=3
AIDCS_AGENT_NAVIGATION_AGENT_CONFIDENCE=0.95
# Route overrides (optional)
AIDCS_ROUTE_HOME=/
AIDCS_ROUTE_DASHBOARD=/dashboard
AIDCS_ROUTE_PAYMENTS=/billing
AIDCS_ROUTE_SETTINGS=/settings
AIDCS_ROUTE_SUPPORT=/support

# Content
AIDCS_AGENT_CONTENT_AGENT_SECTIONS=AI-Sect-3-CNT,AI-Sect-4-DSP
AIDCS_AGENT_CONTENT_AGENT_PRIORITY=3
AIDCS_AGENT_CONTENT_AGENT_MAX_ACTIONS=4
AIDCS_AGENT_CONTENT_AGENT_CONFIDENCE=0.92

# Analytics
AIDCS_AGENT_ANALYTICS_AGENT_SECTIONS=AI-Sect-1-HDR,AI-Sect-6-FTR
AIDCS_AGENT_ANALYTICS_AGENT_PRIORITY=4
AIDCS_AGENT_ANALYTICS_AGENT_MAX_ACTIONS=10
AIDCS_AGENT_ANALYTICS_AGENT_CONFIDENCE=0.98

# UI Controller
AIDCS_AGENT_UI_CONTROLLER_AGENT_SECTIONS=AI-Sect-3-CNT,AI-Sect-4-DSP,AI-Sect-5-AIC
AIDCS_AGENT_UI_CONTROLLER_AGENT_PRIORITY=5
AIDCS_AGENT_UI_CONTROLLER_AGENT_MAX_ACTIONS=6
AIDCS_AGENT_UI_CONTROLLER_AGENT_CONFIDENCE=0.97

# Supervisor
AIDCS_AGENT_SUPERVISOR_AGENT_PRIORITY=0
AIDCS_AGENT_SUPERVISOR_AGENT_MAX_ACTIONS=20
AIDCS_AGENT_SUPERVISOR_AGENT_CONFIDENCE=0.99

# Default agent if none detected
AIDCS_DEFAULT_AGENT=assistant_agent

# ========= Runtime feature flags (optional) =========
AIDCS_USER_ID=guest
AIDCS_GEMINI_API_KEY=your_gemini_api_key_here
AIDCS_VOICE_ENABLED=false
AIDCS_KERNEL_BATCH_SIZE=5
AIDCS_PERF_ERROR_THRESHOLD=5
