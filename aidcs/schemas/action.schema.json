{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIDCS Action Definition",
  "type": "object",
  "required": ["name", "allowed_sections", "dom_operation"],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "allowed_sections": {
      "type": "array",
      "items": { "type": "string" }
    },
    "parameters": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dom_operation": { "type": "string" }
  }
}
