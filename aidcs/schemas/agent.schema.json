{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIDCS Agent Definition",
  "type": "object",
  "required": ["name", "role", "priority", "allowed_sections"],
  "properties": {
    "name": { "type": "string" },
    "role": { "type": "string" },
    "priority": { "type": "integer" },
    "allowed_sections": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
