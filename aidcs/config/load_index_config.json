{
  "schema_version": "1.0",

  "loader_identity": {
    "name": "AIDCS Index Loader",
    "purpose": "load_and_validate_project_index_config",
    "target_accuracy": 0.98
  },

  "config_search_policy": {

    "search_order": [
      "index.json",
      "config/index.json",
      "aidcs/index.json"
    ],

    "stop_on_first_match": true,
    "allow_remote_config": false
  },

  "file_validation": {

    "required_file": "index.json",

    "required_fields": [
      "schema_version",
      "project_identity",
      "aidcs_architecture",
      "validation_pipeline"
    ],

    "strict_mode": true,
    "reject_unknown_fields": false
  },

  "accuracy_policy": {

    "minimum_allowed_accuracy": 0.95,
    "recommended_accuracy": 0.98,
    "reject_below_threshold": true
  },

  "structure_validation": {

    "required_sections": [
      "aidcs_architecture",
      "validation_pipeline",
      "runtime_execution_flow",
      "safety_rules"
    ],

    "max_config_size_kb": 200,
    "json_schema_validation": true
  },

  "security_policy": {

    "restricted_modifications": [
      "framework_core",
      "authentication_system",
      "routing_system",
      "database_connections"
    ],

    "allowed_ai_operations": [
      "read_dom_sections",
      "update_display_sections",
      "inject_ai_components"
    ],

    "forbidden_ai_operations": [
      "delete_application_logic",
      "modify_security_system",
      "rewrite_framework_core"
    ]
  },

  "runtime_cache_policy": {

    "enable_cache": true,
    "cache_scope": "runtime",
    "cache_refresh": "restart_required"
  },

  "fallback_policy": {

    "on_missing_config": "halt_execution",

    "fallback_config_location": "aidcs/default/index.default.json",

    "allow_fallback": false
  },

  "error_handling": {

    "log_level": "critical",

    "error_actions": {
      "missing_file": "halt",
      "invalid_json": "halt",
      "missing_required_fields": "halt",
      "accuracy_below_threshold": "halt"
    }
  },

  "development_mode": {

    "display_loader_status": true,
    "log_config_source": true,
    "warn_on_missing_optional_fields": true
  },

  "build_mode": {

    "remove_debug_logs": true,
    "validate_before_build": true,
    "stop_build_on_error": true
  },

  "execution_sequence": [

    "locate_config_file",
    "read_file",
    "parse_json",
    "validate_schema",
    "validate_structure",
    "validate_accuracy",
    "apply_security_rules",
    "cache_config",
    "return_config"
  ]
}
