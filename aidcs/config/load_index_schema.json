{
  "$schema": "http://json-schema.org/draft-07/schema#",

  "title": "AIDCS Index Configuration Schema",

  "description": "Schema validation for index.json used by the AIDCS frontend AI control system",

  "type": "object",

  "required": [
    "schema_version",
    "project_identity",
    "aidcs_architecture",
    "validation_pipeline",
    "runtime_execution_flow",
    "safety_rules"
  ],

  "properties": {

    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },

    "project_identity": {
      "type": "object",
      "required": [
        "project_name",
        "architecture_type",
        "target_accuracy"
      ],
      "properties": {
        "project_name": {
          "type": "string",
          "minLength": 3
        },
        "architecture_type": {
          "type": "string"
        },
        "target_accuracy": {
          "type": "number",
          "minimum": 0.95,
          "maximum": 1.0
        },
        "framework_support": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "system_name": {
      "type": "string",
      "minLength": 3
    },

    "target_accuracy": {
      "type": "number",
      "minimum": 0.95,
      "maximum": 1.0
    },

    "core_policy": {
      "type": "object",
      "properties": {

        "ai_behavior": {
          "type": "string"
        },

        "ai_must_read_index_before_execution": {
          "type": "boolean"
        },

        "ai_must_follow_section_permissions": {
          "type": "boolean"
        },

        "ai_must_not_modify_application_logic": {
          "type": "boolean"
        },

        "ai_must_not_delete_existing_code": {
          "type": "boolean"
        }

      }
    },

    "governance_policy": {
      "type": "object",
      "properties": {
        "ai_behavior": {
          "type": "string"
        },
        "ai_must_read_index_before_execution": {
          "type": "boolean"
        },
        "ai_must_follow_structure": {
          "type": "boolean"
        },
        "ai_must_not_modify_application_logic": {
          "type": "boolean"
        },
        "ai_must_not_delete_existing_code": {
          "type": "boolean"
        }
      }
    },

    "project_structure": {

      "type": "object",

      "properties": {

        "allowed_root_folders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "required_folders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }

      }

    },

    "aidcs_architecture": {

      "type": "object",

      "required": [
        "section_prefix",
        "section_format",
        "default_sections"
      ],

      "properties": {

        "section_prefix": {
          "type": "string",
          "pattern": "^AI-Sect$"
        },

        "section_format": {
          "type": "string"
        },

        "auto_reindex_sections": {
          "type": "boolean"
        },

        "scan_dom_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },

        "generate_dom_map": {
          "type": "boolean"
        },

        "default_sections": {

          "type": "array",

          "items": {

            "type": "object",

            "required": [
              "index",
              "name",
              "short"
            ],

            "properties": {

              "index": {
                "type": "integer",
                "minimum": 1
              },

              "name": {
                "type": "string"
              },

              "short": {
                "type": "string",
                "maxLength": 6
              }

            }

          }

        }

      }

    },

    "ai_dom_registry": {

      "type": "object",

      "properties": {

        "registry_file": {
          "type": "string"
        },

        "auto_generate": {
          "type": "boolean"
        },

        "required_fields": {

          "type": "array",

          "items": {
            "type": "string"
          }

        }

      }

    },

    "agent_control_policy": {

      "type": "object",

      "properties": {

        "agents": {

          "type": "array",

          "items": {

            "type": "object",

            "required": [
              "name",
              "allowed_sections"
            ],

            "properties": {

              "name": {
                "type": "string"
              },

              "allowed_sections": {

                "type": "array",

                "items": {
                  "type": "string",
                  "pattern": "^AI-Sect-[0-9]+-[A-Z]+$"
                }

              }

            }

          }

        }

      }

    },

    "development_overlay": {

      "type": "object",

      "properties": {

        "enabled": {
          "type": "boolean"
        },

        "display_section_labels": {
          "type": "boolean"
        },

        "overlay_font_size": {
          "type": "string"
        },

        "overlay_opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },

        "toggle_key": {
          "type": "string"
        }

      }

    },

    "build_optimization": {

      "type": "object",

      "properties": {

        "remove_dev_overlay": {
          "type": "boolean"
        },

        "remove_debug_logs": {
          "type": "boolean"
        },

        "preserve_ai_section_ids": {
          "type": "boolean"
        },

        "compress_dom_registry": {
          "type": "boolean"
        }

      }

    },

    "validation_pipeline": {

      "type": "array",

      "items": {
        "type": "string"
      },

      "minItems": 1

    },

    "runtime_execution_flow": {

      "type": "array",

      "items": {
        "type": "string"
      },

      "minItems": 3

    },

    "safety_rules": {

      "type": "object",

      "required": [
        "forbidden_ai_actions",
        "allowed_ai_actions"
      ],

      "properties": {

        "forbidden_ai_actions": {

          "type": "array",

          "items": {
            "type": "string"
          }

        },

        "allowed_ai_actions": {

          "type": "array",

          "items": {
            "type": "string"
          }

        }

      }

    },

    "confidence_thresholds": {

      "type": "object",

      "properties": {

        "minimum_ai_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },

        "auto_execute_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },

        "require_human_review_below": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }

      }

    }

  }
}
