{
  "name": "aidcs",
  "version": "1.0.0",
  "description": "Zero-dependency Multi-Agent DOM Orchestrator for mapping websites to AI ecosystems natively.",
  "type": "module",
  "keywords": [
    "ai",
    "dom",
    "orchestrator",
    "llm",
    "multi-agent",
    "websocket",
    "tts",
    "netzach"
  ],
  "author": "",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "type-check": "tsc --noEmit",
    "precommit": "npm run lint:fix && npm run format && npm run type-check && npm run test"
  },
  "main": "dist/aidcs/index.js",
  "types": "dist/aidcs/index.d.ts",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/ui": "^4.1.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "jsdom": "^29.0.1"
  }
}
